rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ngày hiện tại theo giờ máy chủ, múi giờ Việt Nam (UTC+7), dạng YYYY-MM-DD
    function dayKey() {
      let d = request.time + duration.value(7, 'h');
      return string(d.year()) + '-'
        + (d.month() < 10 ? '0' : '') + string(d.month()) + '-'
        + (d.day() < 10 ? '0' : '') + string(d.day());
    }

    match /users/{uid}/checkins/{day} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      // Chỉ được tạo 1 lần/ngày, thời gian bắt buộc là giờ máy chủ, không cho sửa
      allow create: if request.auth != null
        && request.auth.uid == uid
        && day == dayKey()
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }
  }
}
