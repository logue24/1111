PORT=3000
NODE_ENV=development
# Ví dụ: postgres://username:password@localhost:5432/diemdanh
DATABASE_URL=postgres://postgres:postgres@localhost:5432/diemdanh
# Tạo chuỗi ngẫu nhiên dài tối thiểu 32 ký tự trước khi triển khai
SESSION_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_DAI_IT_NHAT_32_KY_TU
# Múi giờ dùng để xác định ngày điểm danh (mặc định Việt Nam)
APP_TIME_ZONE=Asia/Ho_Chi_Minh
# Khi chạy sau proxy HTTPS trên nền tảng deploy, giữ true
TRUST_PROXY=false
